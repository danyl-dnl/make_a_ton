# ==============================================================================
# Brightloop Software - Subscription Management System
# Environment Configuration Template
# DO NOT COMMIT REAL PASSWORDS OR SECRETS TO VERSION CONTROL
# ==============================================================================

# Application Metadata
APP_NAME="Brightloop Subscription Management System"
APP_ENV=development
DEBUG=True
API_V1_STR=/api

# Backend Server Runtime
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database Configuration (Local Docker)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=brightloop_db

# Optional: Explicit Database URLs (if omitted, constructed automatically from POSTGRES_* vars)
# SYNC_DATABASE_URL=postgresql+psycopg2://postgres:your_secure_postgres_password_here@localhost:5434/brightloop_db
# ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:your_secure_postgres_password_here@localhost:5434/brightloop_db

# Security & CORS (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
